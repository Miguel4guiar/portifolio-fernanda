# Copie este arquivo para ".env" (mesma pasta) e preencha.
#
# Senha da área reservada da fotógrafa (site.com/#admin).
# Troque isso antes de publicar o site — se deixar em branco, o padrão é "raio2026".
VITE_ADMIN_PASSWORD=escolha_uma_senha_aqui

# Credenciais do Sanity — veja o passo a passo no README, seção "Conectando o CMS".
# Onde encontrar: sanity.io/manage -> seu projeto -> Project ID
# O dataset padrão criado pelo assistente do Sanity chama-se "production".
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
